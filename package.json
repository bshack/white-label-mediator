{
  "name": "white-label-mediator",
  "version": "3.1.0",
  "description": "A simple ES6 JS mediator that allows communication between views.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=10.0"
  },
  "contributors": [
    {
      "name": "Bill Shackelford",
      "url": "https://github.com/bshack"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && npm run test:unit",
    "audit": "npm audit --audit-level=high",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "jasmine",
    "coverage": "npm run build && npm run test:types && c8 npm run test:unit",
    "prepack": "npm run build",
    "test:types": "tsc -p tsconfig.consumer.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshack/white-label-mediator.git"
  },
  "keywords": [
    "javascript",
    "js",
    "mediator",
    "es6",
    "es2015"
  ],
  "author": {
    "name": "Bill Shackelford",
    "url": "https://github.com/bshack"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bshack/white-label-mediator/issues"
  },
  "homepage": "https://github.com/bshack/white-label-mediator#readme",
  "dependencies": {
    "events": "3.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "jasmine": "7.0.0",
    "typescript": "7.0.2"
  },
  "types": "dist/index.d.ts",
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "perFile": true,
    "exclude": [
      "**/*.d.ts"
    ]
  }
}
