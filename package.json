{
  "name": "white-label-mediator",
  "version": "5.0.0",
  "description": "Lightweight standards-based TypeScript event bus for loosely coupled browser and Node.js applications with optional typed events.",
  "sideEffects": false,
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "contributors": [
    {
      "name": "Bill Shackelford",
      "url": "https://github.com/bshack"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --run build && node --run test:types && node --run test:unit",
    "audit": "npm audit --audit-level=high",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test test/*.test.js",
    "coverage": "node --run build && node --run test:types && c8 node --run test:unit",
    "benchmark": "node --run build && node benchmark/mediator.bench.js",
    "prepare": "node --run build",
    "test:types": "tsc -p tsconfig.consumer.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "node --run lint -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshack/white-label-mediator.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "events",
    "event-bus",
    "pub-sub",
    "mediator",
    "eventtarget",
    "customevent",
    "web-standards",
    "framework-independent",
    "browser",
    "node",
    "server-side",
    "serverless",
    "universal"
  ],
  "author": {
    "name": "Bill Shackelford",
    "url": "https://github.com/bshack"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bshack/white-label-mediator/issues"
  },
  "homepage": "https://whitelabeljs.org/docs/mediator/",
  "devDependencies": {
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "typescript": "7.0.2",
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0"
  },
  "types": "dist/index.d.ts",
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "perFile": true,
    "exclude": [
      "**/*.d.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
